#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uInput;

layout(set = 0, binding = 1, rgba8) uniform writeonly image2D uOutput;

layout(push_constant) uniform Params {
    float sharpness;
    float mode; // 0 = CAS-like, 1 = RCAS-like
    vec2 inputSize;
    vec2 outputSize;
} pc;

vec3 sampleAt(ivec2 p) {
    ivec2 sizeI = ivec2(pc.inputSize);
    p = clamp(p, ivec2(0), sizeI - ivec2(1));
    return texelFetch(uInput, p, 0).rgb;
}

void main() {
    ivec2 outPx = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSizeI = ivec2(pc.outputSize);
    if (any(greaterThanEqual(outPx, outSizeI))) return;

    // Map output pixels to input pixels. This gives the post-process stage
    // both its upscale and sharpen role in one GPU pass.
    vec2 src = (vec2(outPx) + 0.5) * pc.inputSize / pc.outputSize - 0.5;
    ivec2 c = ivec2(floor(src));
    vec3 e = sampleAt(c);
    vec3 n = sampleAt(c + ivec2(0,-1));
    vec3 s = sampleAt(c + ivec2(0, 1));
    vec3 w = sampleAt(c + ivec2(-1,0));
    vec3 east = sampleAt(c + ivec2(1,0));

    // RCAS-style adaptive cross kernel. The limiter is deliberately
    // conservative so UI/text edges get detail back without excessive halos.
    vec3 mn = min(e, min(min(n,s), min(w,east)));
    vec3 mx = max(e, max(max(n,s), max(w,east)));
    vec3 contrast = max(mx - mn, vec3(1.0 / 255.0));
    vec3 amp = clamp((min(mn, 1.0 - mx) / contrast), 0.0, 1.0);
    float adaptive = clamp(sqrt(max(min(amp.r, min(amp.g, amp.b)), 0.0)), 0.0, 1.0);

    float sharp = clamp(pc.sharpness, 0.0, 1.0);
    float baseWeight = mix(0.05, 0.24, sharp);
    float wgt = -baseWeight * mix(0.55, 1.0, adaptive);

    vec3 rcas = (e + (n + s + w + east) * wgt) / (1.0 + 4.0 * wgt);

    // CAS-like mode keeps more of the original signal and is slightly softer.
    vec3 result = (pc.mode < 0.5)
        ? mix(e, rcas, sharp * 0.78)
        : mix(e, rcas, sharp);

    // Bilinear reconstruction is used only for the fractional part of an
    // upscale. The RCAS correction above remains centered on the nearest
    // source pixel, avoiding a second full-screen pass.
    if (pc.outputSize.x > pc.inputSize.x || pc.outputSize.y > pc.inputSize.y) {
        vec2 uv = (vec2(outPx) + 0.5) / pc.outputSize;
        result = mix(result, textureLod(uInput, uv, 0.0).rgb, 0.22);
    }

    imageStore(uOutput, outPx, vec4(clamp(result, 0.0, 1.0), e == e ? 1.0 : 1.0));
}
